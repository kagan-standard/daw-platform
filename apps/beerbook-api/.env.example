# beerbook-api — set in infra/compose/.env or docker-compose environment
KEYCLOAK_ISSUER=https://auth.beerbookapp.com/realms/daw
KEYCLOAK_JWKS_URI=https://auth.beerbookapp.com/realms/daw/protocol/openid-connect/certs
# Client used for ROPC (login / auto-login); must have Direct Access Grants enabled in Keycloak
KEYCLOAK_MOBILE_CLIENT_ID=beerbook-mobile
SUPABASE_REST_URL=http://supabase-rest:3000
SUPABASE_SERVICE_ROLE_KEY=<from infra/compose .env>
# Scripts (seed-border-cosmetics.js, check-and-backfill-achievement-cosmetics.js) use the same keys;
# they also accept SUPABASE_URL and SUPABASE_SERVICE_KEY. For Supabase Hosted use https://<project-ref>.supabase.co
PORT=3001
CORS_ORIGIN=https://beerbookapp.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TOKEN_CLOCK_SKEW_SECONDS=30
# Uploads: directory for profile/beer photos; base URL for returned upload URLs
UPLOAD_DIR=/data/uploads
API_BASE_URL=https://api.beerbookapp.com
# Async image moderation (Google Cloud Vision Safe Search). Set to false to disable (e.g. dev without credentials).
# On VPS: key file is kept at /opt/secrets/gcp-vision-key.json
# GOOGLE_APPLICATION_CREDENTIALS=/opt/secrets/gcp-vision-key.json
# MODERATION_ENABLED=false
