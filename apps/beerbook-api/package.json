{
  "name": "beerbook-api",
  "version": "1.0.0",
  "description": "BFF for BeerBook — validates Keycloak tokens, proxies to PostgREST",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "tabs:weekly-eval": "node scripts/weekly-tabs-eval.js",
    "tabs:streak-risk": "node scripts/streak-risk-check.js",
    "push:dispatch": "node scripts/push-dispatch.js",
    "push:receipts": "node scripts/push-receipts.js",
    "push:token-prune": "node scripts/push-token-prune.js",
    "ci:check-migrations": "node scripts/check-migration-safety.js"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@tootallnate/once": ">=3.0.1"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.0.0",
    "@sentry/node": "^10.48.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.2.0",
    "jose": "^5.9.6",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  }
}
