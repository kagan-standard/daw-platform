# DAW Platform Phase 1 — Copy to .env and fill. Never commit .env.
# Generate PGRST_JWT_SECRET (32+ chars), then anon/service_role JWTs — see runbooks/secret_rotation.md

# ---------- Keycloak ----------
KC_DB_PASSWORD=change-me-keycloak-db-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# ---------- Supabase (internal only) ----------
SUPABASE_DB_PASSWORD=change-me-supabase-db-password
# HS256 secret for PostgREST and Realtime (min 32 chars). Generate: openssl rand -base64 32
PGRST_JWT_SECRET=change-me-min-32-char-secret-for-jwt-signing
# JWTs signed with PGRST_JWT_SECRET. Generate with runbooks/secret_rotation.md or:
# anon:  {"role":"anon","iss":"daw","iat":...,"exp":...}  exp far future
# service_role: {"role":"service_role","iss":"daw","iat":...,"exp":...}
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6ImRhdyIsImV4cCI6OTk5OTk5OTk5OX0.placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoiZGF3IiwiZXhwIjo5OTk5OTk5OTk5fQ.placeholder

# ---------- beerbook-api (uses SUPABASE_SERVICE_ROLE_KEY above) ----------
# KEYCLOAK_ISSUER, KEYCLOAK_JWKS_URI, CORS_ORIGIN, RATE_LIMIT_* set in docker-compose defaults.
# Override here if needed.

# ---------- Traefik ----------
# If your Traefik uses different entrypoint/certresolver, override via labels in compose or
# set COMPOSE_PROJECT_NAME if needed.
